{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "@id": "https://chesapeakedatacampus.com/newsroom/{Slug}#article",
      "mainEntityOfPage": "https://chesapeakedatacampus.com/newsroom/{Slug}",
      "headline": "{Name}",
      "image": ["{Cover Image}"],
      "datePublished": "{Publish Date}",
      "author": { "@type": "Person", "name": "{Author}" },
      "publisher": { "@id": "https://chesapeakedatacampus.com/#organization" },
      "isPartOf": { "@id": "https://chesapeakedatacampus.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "News", "item": "https://chesapeakedatacampus.com/newsroom" },
        { "@type": "ListItem", "position": 2, "name": "{Name}", "item": "https://chesapeakedatacampus.com/newsroom/{Slug}" }
      ]
    }
  ]
}
