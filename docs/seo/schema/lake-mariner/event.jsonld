{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Event",
      "@id": "https://lakemarinerdata.com/events/{Slug}#event",
      "url": "https://lakemarinerdata.com/events/{Slug}",
      "name": "{Name}",
      "startDate": "{Start}",
      "endDate": "{End}",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": "{Location}",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Barker",
          "addressRegion": "NY",
          "addressCountry": "US"
        }
      },
      "image": ["{Image}"],
      "description": "{Summary}",
      "organizer": { "@id": "https://lakemarinerdata.com/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Events", "item": "https://lakemarinerdata.com/events" },
        { "@type": "ListItem", "position": 2, "name": "{Name}", "item": "https://lakemarinerdata.com/events/{Slug}" }
      ]
    }
  ]
}
